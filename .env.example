# Copy to .env.local for development.

# Canonical public URL of the site. Used for metadata, Open Graph and the
# sitemap. Safe to expose — NEXT_PUBLIC_ means it is sent to the browser.
# Baked in at build time, so changing it needs a redeploy.
NEXT_PUBLIC_SITE_URL=""

# Neon POOLED connection string — the one whose host contains "-pooler".
# The running app uses this: it opens a connection per serverless invocation,
# and the pooler is what stops that exhausting Postgres.
DATABASE_URL=""

# Neon DIRECT connection string — same database, host without "-pooler".
# Prisma CLI only (migrate, generate, studio). Migrations run session-level
# statements that the pooler cannot handle.
DIRECT_URL=""

# Auth.js signing secret — signs the session cookie. Generate with: npx auth secret
AUTH_SECRET=""

# The single admin account. There is no registration and no reset flow, so
# these two variables ARE the account. Never store the plain password here:
#   node scripts/hash-password.mjs "the password"
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""

# Cloudflare R2 (S3-compatible) file storage.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# R2_PUBLIC_URL=""
